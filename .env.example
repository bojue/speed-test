# 监听端口（默认 3000）
PORT=3000

# 生产环境设为 production（提供静态文件服务）
NODE_ENV=production

# 可选：API 鉴权密钥，设置后 /api/audit-url、/api/diagnose 需要 x-api-key 头
API_KEY=

# 可选：反向代理跳数（前面加了 X-Forwarded-For 时设为 1）
TRUST_PROXY=1

# 可选：Gemini AI 诊断密钥
GEMINI_API_KEY=

# RUM 数据持久化文件路径（默认 rum-beacons.json）
RUM_DB_PATH=rum-beacons.json
